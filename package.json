{
	"name": "kirill.es",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite dev",
		"preview": "vite preview",
		"start": "node build/index.js",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.22.0",
		"@sveltejs/adapter-node": "^5.3.0",
		"@sveltejs/kit": "^2.33.0",
		"@types/node": "^22",
		"eslint": "^9.22.0",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.3",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.17.0",
		"svelte-eslint-parser": "^1.3.3",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.544.0"
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix",
			"prettier --write"
		],
		"*.svelte": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,html,css,md}": [
			"prettier --write"
		]
	}
}
