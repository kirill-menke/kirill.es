# Copy to .env (npm run dev) or .env.prod / .env.dev (PM2, see ecosystem.config.cjs).
# All .env* files except this one are gitignored. Never commit real keys.

# Runtime mode (informational; auth fails closed in any production build when ADMIN_PASSWORD is unset).
NODE_ENV=production
# Port and interface adapter-node (build/index.js) listens on.
PORT=3000
HOST=0.0.0.0

# Public origin of the site; adapter-node needs it for CSRF checks on form/POST requests behind a proxy.
# ORIGIN=https://kirill.es
# Header carrying the real client IP when behind a reverse proxy (used by rate limiting + access log).
# ADDRESS_HEADER=X-Forwarded-For

# HTTP Basic auth password (any username) for /landscape and all /api/*.
# Unset: allowed in `npm run dev`, 503 in production.
ADMIN_PASSWORD=

# Google Gemini API key, required for /api/generate-image.
GEMINI_API_KEY=
# Stability AI API key, optional: inpaints seams between new tile and neighbors (skipped if unset).
STABILITY_API_KEY=

# SQLite file path (optional). Default: <cwd>/landscape.db (repo root under PM2 and vite dev).
# DATABASE_PATH=/var/lib/kirill.es/landscape.db

# "true" writes image-pipeline debug images to <cwd>/debug/. Default off.
DEBUG_PIPELINE=false
