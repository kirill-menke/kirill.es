# Optional: copy to .env for `npm run build && npm start`. The site needs no secrets;
# these are adapter-node settings. All .env* files except this one are gitignored.

NODE_ENV=production
# Port and interface adapter-node (build/index.js) listens on.
PORT=3000
HOST=0.0.0.0

# Public origin of the site; adapter-node needs it for CSRF checks on form/POST requests behind a proxy.
# ORIGIN=https://kirill.es
# Header carrying the real client IP when behind a reverse proxy (used by the access log).
# ADDRESS_HEADER=X-Forwarded-For
